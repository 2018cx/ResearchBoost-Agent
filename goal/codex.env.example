# Model access for the Codex agent. Copy to goal/codex.env (git-ignored) and fill in.
# sandbox.sh passes these into the sandbox; setup_home.sh writes the endpoint into the task's Codex config.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional: the model name your endpoint serves. Empty = the Codex default.
CODEX_MODEL=
